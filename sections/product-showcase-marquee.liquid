{%- liquid
  assign featured_product = section.settings.product
-%}

{%- style -%}
  #ProductShowcase-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #ProductShowcase-{{ section.id }} .product-showcase__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    min-height: 50rem;
    padding: 3rem 8%;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__image-wrap {
    position: relative;
    display: flex;
    min-height: 44rem;
    align-items: center;
    justify-content: center;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__image-wrap::before {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    color: rgba(255, 255, 255, 0.65);
    content: '{{ section.settings.background_word | escape }}';
    font-size: clamp(7rem, 12vw, 17rem);
    font-weight: 700;
    line-height: 0.8;
    white-space: nowrap;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__image {
    position: relative;
    z-index: 1;
    width: min(100%, 48rem);
    height: 44rem;
    object-fit: contain;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__details {
    max-width: 58rem;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__title {
    margin: 0 0 1.5rem;
    font-size: clamp(3.2rem, 4vw, 6rem);
    line-height: 1.05;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__description {
    margin: 0 0 1.8rem;
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.6;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__price {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2.8rem;
    color: {{ section.settings.accent_color }};
    font-size: clamp(2.2rem, 3vw, 3.6rem);
  }

  #ProductShowcase-{{ section.id }} .product-showcase__price s {
    color: rgba(0, 0, 0, 0.45);
    font-size: 0.65em;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__button {
    display: inline-flex;
    min-height: 5rem;
    align-items: center;
    padding: 0.8rem 2.8rem;
    border-radius: 3rem;
    background: #000;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__products {
    display: flex;
    gap: 2.5rem;
    width: calc(50% - 8%);
    margin: 0 8% 0 50%;
    padding: 0 0 3.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__products::-webkit-scrollbar {
    display: none;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__slider {
    position: relative;
    padding-bottom: 3.5rem;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__slider-button {
    position: absolute;
    z-index: 1;
    top: 7.7rem;
    display: flex;
    width: 4.6rem;
    height: 4.6rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0.1rem solid currentColor;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__slider-button svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__slider-button--prev {
    left: calc(50% - 7.5rem);
  }

  #ProductShowcase-{{ section.id }} .product-showcase__slider-button--prev svg {
    transform: rotate(180deg);
  }

  #ProductShowcase-{{ section.id }} .product-showcase__slider-button--next {
    right: 3%;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__slider-button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__product {
    flex: 0 0 calc((100% - 5rem) / 3);
    scroll-snap-align: start;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__product a {
    color: inherit;
    text-decoration: none;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__product-image {
    display: flex;
    height: 14.4rem;
    align-items: center;
    justify-content: center;
    border: 0.1rem solid rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.6);
  }

  #ProductShowcase-{{ section.id }} .product-showcase__product-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #ProductShowcase-{{ section.id }} .product-showcase__product-title {
    display: block;
    margin-top: 1.2rem;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #ProductShowcase-{{ section.id }} .product-showcase__hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 2rem;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__image-wrap {
      min-height: 30rem;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__image {
      height: 30rem;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__details {
      text-align: center;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__price {
      justify-content: center;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__products {
      width: auto;
      margin: 0;
      padding: 0 2rem 2.5rem;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__slider {
      padding-bottom: 0;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__slider-button {
      display: none;
    }

    #ProductShowcase-{{ section.id }} .product-showcase__product {
      flex-basis: 16rem;
    }
  }
{%- endstyle -%}

<section id="ProductShowcase-{{ section.id }}" class="product-showcase">
  <div class="product-showcase__hero">
    <div class="product-showcase__image-wrap">
      {%- if featured_product != blank and featured_product.featured_image != blank -%}
        {{
          featured_product.featured_image
          | image_url: width: 1200
          | image_tag:
            class: 'product-showcase__image',
            widths: '360, 540, 720, 960, 1200',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            alt: featured_product.featured_image.alt
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-showcase__image placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="product-showcase__details">
      <h2 class="product-showcase__title">
        {%- if featured_product != blank -%}
          {{ featured_product.title | escape }}
        {%- else -%}
          {{ section.settings.fallback_title | escape }}
        {%- endif -%}
      </h2>
      {%- if section.settings.description != blank -%}
        <div class="product-showcase__description">{{ section.settings.description }}</div>
      {%- elsif featured_product != blank and featured_product.description != blank -%}
        <div class="product-showcase__description">{{ featured_product.description | strip_html | truncatewords: 28 }}</div>
      {%- endif -%}
      {%- if featured_product != blank -%}
        <div class="product-showcase__price">
          {%- if featured_product.compare_at_price > featured_product.price -%}
            <s>{{ featured_product.compare_at_price | money }}</s>
          {%- endif -%}
          <span>From {{ featured_product.price | money }}</span>
        </div>
        <a class="product-showcase__button" href="{{ featured_product.url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <slider-component class="product-showcase__slider">
      <button
        type="button"
        class="product-showcase__slider-button product-showcase__slider-button--prev"
        name="previous"
        aria-label="{{ 'general.slider.previous_slide' | t }}"
      >
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </button>

      <div id="Slider-{{ section.id }}" class="product-showcase__products" role="list">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <div
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="product-showcase__product"
            role="listitem"
            {{ block.shopify_attributes }}
          >
            <a href="{{ product.url | default: '#' }}">
              <div class="product-showcase__product-image">
                {%- if product != blank and product.featured_image != blank -%}
                  {{
                    product.featured_image
                    | image_url: width: 400
                    | image_tag:
                      widths: '160, 240, 320, 400',
                      sizes: '160px',
                      loading: 'lazy',
                      alt: product.featured_image.alt
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <span class="product-showcase__product-title">{{ product.title | default: 'Select a product' | escape }}</span>
            </a>
          </div>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="product-showcase__slider-button product-showcase__slider-button--next"
        name="next"
        aria-label="{{ 'general.slider.next_slide' | t }}"
      >
        {{- 'icon-arrow.svg' | inline_asset_content -}}
      </button>
    </slider-component>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "fallback_title",
      "label": "Fallback title",
      "default": "Choose a featured product"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Choose options"
    },
    {
      "type": "text",
      "id": "background_word",
      "label": "Background word",
      "default": "SALE"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Price accent color",
      "default": "#c8104f"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Product showcase",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
