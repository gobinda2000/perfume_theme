{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign posts_displayed = section.settings.blog.articles_count
  if section.settings.post_limit < section.settings.blog.articles_count
    assign posts_displayed = section.settings.post_limit
  endif
-%}

<div class="blog editorial-blog color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width editorial-blog__container section-{{ section.id }}-padding">
    <div class="editorial-blog__intro">
      {%- unless section.settings.heading == blank -%}
        <h2
          id="SectionHeading-{{ section.id }}"
          class="editorial-blog__title {{ section.settings.heading_size }}"
        >
          {{ section.settings.heading }}
        </h2>
      {%- endunless -%}
      {%- unless section.settings.subheading == blank -%}
        <div class="editorial-blog__subheading rte">{{ section.settings.subheading }}</div>
      {%- endunless -%}
    </div>

    <slider-component class="editorial-blog__slider slider-mobile-gutter">
      <ul
        id="Slider-{{ section.id }}"
        class="editorial-blog__posts slider slider--everywhere"
        role="list"
        aria-labelledby="SectionHeading-{{ section.id }}"
      >
        {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
          {%- for article in section.settings.blog.articles limit: section.settings.post_limit -%}
            {%- assign adjacent_article = section.settings.blog.articles[forloop.index] -%}
            {%- if adjacent_article == blank -%}
              {%- assign adjacent_article = section.settings.blog.articles[0] -%}
            {%- endif -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="editorial-blog__slide slider__slide"
            >
              <article class="editorial-blog__item">
                <a class="editorial-blog__image editorial-blog__image--primary" href="{{ article.url }}">
                  {%- if section.settings.show_image and article.image -%}
                    {{
                      article.image
                      | image_url: width: 1000
                      | image_tag:
                        widths: '360, 533, 720, 1000',
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        loading: 'lazy',
                        alt: article.image.alt
                    }}
                  {%- else -%}
                    {{ 'blog-apparel-1' | placeholder_svg_tag: 'editorial-blog__placeholder' }}
                  {%- endif -%}
                </a>

                <div class="editorial-blog__content">
                  {%- if section.settings.show_date -%}
                    {{ article.published_at | time_tag: format: 'date' }}
                  {%- endif -%}
                  <h3 class="editorial-blog__article-title">
                    <a href="{{ article.url }}">{{ article.title | escape }}</a>
                  </h3>
                  {%- if article.excerpt != blank or article.content != blank -%}
                    <p class="editorial-blog__excerpt">
                      {{ article.excerpt | default: article.content | strip_html | truncatewords: 28 }}
                    </p>
                  {%- endif -%}
                  <a class="editorial-blog__button button button--secondary" href="{{ article.url }}">
                    {{ section.settings.button_label }}
                  </a>
                </div>

                <a class="editorial-blog__image editorial-blog__image--adjacent" href="{{ adjacent_article.url }}">
                  {%- if section.settings.show_image and adjacent_article.image -%}
                    {{
                      adjacent_article.image
                      | image_url: width: 1000
                      | image_tag:
                        widths: '360, 533, 720, 1000',
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        loading: 'lazy',
                        alt: adjacent_article.image.alt
                    }}
                  {%- else -%}
                    {{ 'blog-apparel-2' | placeholder_svg_tag: 'editorial-blog__placeholder' }}
                  {%- endif -%}
                </a>
              </article>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="editorial-blog__slide editorial-blog__slide--placeholder slider__slide">
            <article class="editorial-blog__item">
              <div class="editorial-blog__image">{{ 'blog-apparel-1' | placeholder_svg_tag: 'editorial-blog__placeholder' }}</div>
              <div class="editorial-blog__content">
                <time>{{ 'now' | date: '%B %d, %Y' }}</time>
                <h3 class="editorial-blog__article-title">{{ 'sections.featured_blog.onboarding_title' | t }}</h3>
                <p class="editorial-blog__excerpt">{{ 'sections.featured_blog.onboarding_content' | t }}</p>
                <span class="editorial-blog__button button button--secondary">{{ section.settings.button_label }}</span>
              </div>
              <div class="editorial-blog__image">{{ 'blog-apparel-2' | placeholder_svg_tag: 'editorial-blog__placeholder' }}</div>
            </article>
          </li>
        {%- endif -%}
      </ul>

      {%- if posts_displayed > 1 -%}
        <div class="editorial-blog__controls slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ posts_displayed }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Featured blog editorial",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Posts to show"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Latest news",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Discover the latest stories, inspiration, and fragrance news.</p>",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" },
        { "value": "hxxl", "label": "Extra extra large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Read more",
      "label": "Button label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "Show article images"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "Show publication date"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Featured blog editorial"
    }
  ]
}
{% endschema %}
