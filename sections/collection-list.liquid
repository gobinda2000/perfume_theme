{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .collection-list-title {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-{{ section.id }}-padding .title-wrapper-with-link {
    justify-content: center;
  }

  .section-{{ section.id }}-padding .collection-list-intro {
    max-width: 62rem;
    margin: 1rem auto 0;
    text-align: center;
    color: rgba(var(--color-foreground), 0.75);
  }

  .section-{{ section.id }}-padding .collection-list__item .card__inner,
  .section-{{ section.id }}-padding .collection-list__item .card__media {
    border-radius: 1rem;
  }

  .section-{{ section.id }}-padding .collection-list__item .card__information {
    text-align: center;
  }

  .section-{{ section.id }}-padding .collection-list__item .card__heading {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media screen and (min-width: 990px) {
    .section-{{ section.id }}-padding slider-component {
      position: relative;
      padding: 0;
    }

    .section-{{ section.id }}-padding .collection-list.slider--desktop {
      align-items: center;
      display: flex;
      flex-wrap: nowrap;
      gap: 2%;
      justify-content: flex-start;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      width: 92%;
      margin: 0 auto;
    }

    .section-{{ section.id }}-padding .collection-list.slider--desktop::-webkit-scrollbar {
      display: none;
    }

    .section-{{ section.id }}-padding .collection-list.slider--desktop .collection-list__item {
      align-self: center;
      box-sizing: border-box;
      flex: 0 0 29.5%;
      width: 29.5%;
      max-width: 29.5%;
    }

    .section-{{ section.id }}-padding .collection-list.slider--desktop .collection-list__item.is-center {
      flex-basis: 32.8%;
      width: 32.8%;
      max-width: 32.8%;
    }

    .section-{{ section.id }}-padding .collection-list.slider--desktop .collection-list__item:first-child {
      margin-left: 0;
      scroll-margin-left: 0;
    }

    .section-{{ section.id }}-padding .collection-list-slider-buttons {
      position: absolute;
      top: 45%;
      right: -5.5rem;
      left: -5.5rem;
      z-index: 2;
      display: flex;
      justify-content: space-between;
      margin: 0;
      pointer-events: none;
      transform: translateY(-50%);
      opacity: 1;
      transition: opacity 0.2s ease;
    }

    .section-{{ section.id }}-padding .collection-list-slider-buttons .slider-button {
      width: 4.4rem;
      height: 4.4rem;
      border: 0.1rem solid rgba(var(--color-foreground), 0.75);
      border-radius: 50%;
      background: rgb(var(--color-background));
      pointer-events: auto;
    }

    .section-{{ section.id }}-padding .collection-list-slider-buttons .slider-button--next {
      margin-right: 0.5rem;
    }

    .section-{{ section.id }}-padding .collection-list-slider-buttons .slider-button--prev {
      margin-left: 0.5rem;
    }

    .section-{{ section.id }}-padding .collection-list-slider-buttons .slider-counter {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
  assign show_desktop_slider = false
  if section.blocks.size > 1
    assign show_desktop_slider = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-list-wrapper page-width isolate{% if show_mobile_slider %} page-width-desktop{% endif %}{% if section.settings.title == blank %} no-heading{% endif %}{% if section.settings.show_view_all == false or section.blocks.size > collections.size %} no-mobile-link{% endif %} section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link{% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2
          id="SectionHeading-{{ section.id }}"
          class="collection-list-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        >
          {{ section.settings.title }}
        </h2>

        {%- if section.settings.show_view_all and show_mobile_slider -%}
          <a
            href="{{ routes.collections_url }}"
            id="ViewAll-{{ section.id }}"
            class="link underlined-link large-up-hide{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            aria-labelledby="ViewAll-{{ section.id }} SectionHeading-{{ section.id }}"
          >
            {{- 'sections.collection_list.view_all' | t -}}
          </a>
        {%- endif -%}
      </div>
      {%- unless section.settings.description == blank -%}
        <div class="collection-list-intro rte">
          {{ section.settings.description }}
        </div>
      {%- endunless -%}
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        class="collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}{% if show_desktop_slider %} slider slider--desktop{% endif %} collection-list--{{ section.blocks.size }}-items"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign columns = section.blocks.size
          if columns > 3
            assign columns = 3
          endif
        -%}
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="collection-list__item grid__item{% if forloop.index == 2 %} is-center{% endif %}{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}{% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
            {% render 'card-collection',
              card_collection: block.settings.collection,
              media_aspect_ratio: section.settings.image_ratio,
              columns: columns,
              placeholder_image: placeholder_image
            %}
          </li>
        {%- endfor -%}
      </ul>
      {%- if show_mobile_slider or show_desktop_slider -%}
        <div class="slider-buttons collection-list-slider-buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
      <div
        class="center collection-list-view-all{% if show_mobile_slider %} small-hide medium-hide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        <a
          href="{{ routes.collections_url }}"
          class="button"
          id="ViewAllButton-{{ section.id }}"
          aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}"
        >
          {{- 'sections.collection_list.view_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    const SECTION_ID = '{{ section.id }}';
    const slider = document.querySelector('#Slider-' + SECTION_ID);
    if (!slider) return;
    const sliderComponent = slider.closest('slider-component');
    if (!sliderComponent) return;

    /* ── Collect original slides ── */
    const originalSlides = Array.from(slider.querySelectorAll('.collection-list__item'));
    const totalOriginal = originalSlides.length;
    if (totalOriginal < 2) return; /* need at least 2 to loop */

    /* ── Clone slides: append copies of ALL originals at end, prepend at start ── */
    const suffixClones = [];
    const prefixClones = [];

    originalSlides.forEach((slide, i) => {
      const clone = slide.cloneNode(true);
      clone.removeAttribute('id');
      clone.classList.add('slider__slide--clone');
      clone.setAttribute('data-clone-of', i);
      suffixClones.push(clone);
    });
    originalSlides.forEach((slide, i) => {
      const clone = slide.cloneNode(true);
      clone.removeAttribute('id');
      clone.classList.add('slider__slide--clone');
      clone.setAttribute('data-clone-of', i);
      prefixClones.push(clone);
    });

    /* Append suffix clones */
    suffixClones.forEach(c => slider.appendChild(c));
    /* Prepend prefix clones (in reverse so order is preserved) */
    prefixClones.reverse().forEach(c => slider.insertBefore(c, slider.firstElementChild));

    /* All items (prefix clones + originals + suffix clones) */
    const allItems = () => Array.from(slider.querySelectorAll('.collection-list__item'));

    /* ── Compute geometry helpers ── */
    const getItemOffset = () => {
      const items = allItems();
      if (items.length < 2) return 0;
      return items[1].offsetLeft - items[0].offsetLeft;
    };

    /* ── Jump (no animation) to a specific item index ── */
    const jumpToIndex = (idx) => {
      const offset = getItemOffset();
      slider.style.scrollBehavior = 'auto';
      slider.scrollLeft = idx * offset;
      /* Restore smooth after a tick */
      requestAnimationFrame(() => {
        slider.style.scrollBehavior = '';
      });
    };

    /* ── Initial position: jump to the first REAL slide (index = totalOriginal) ── */
    const realStartIdx = totalOriginal; /* prefix clones occupy indices 0..(totalOriginal-1) */
    requestAnimationFrame(() => jumpToIndex(realStartIdx));

    /* ── Disable the default boundary-disable on prev/next buttons ── */
    if (sliderComponent.enableSliderLooping !== undefined) {
      sliderComponent.enableSliderLooping = true;
    }
    const prevBtn = sliderComponent.querySelector('button[name="previous"]');
    const nextBtn = sliderComponent.querySelector('button[name="next"]');
    if (prevBtn) prevBtn.removeAttribute('disabled');
    if (nextBtn) nextBtn.removeAttribute('disabled');

    /* ── Center-card tracking (relative to original index) ── */
    let centerRealIndex = 1; /* start with 2nd card centered */
    const updateCenterCard = (realIdx) => {
      centerRealIndex = ((realIdx % totalOriginal) + totalOriginal) % totalOriginal;
      allItems().forEach(item => {
        const origIdx = item.hasAttribute('data-clone-of')
          ? parseInt(item.getAttribute('data-clone-of'))
          : originalSlides.indexOf(item);
        item.classList.toggle('is-center', origIdx === centerRealIndex);
      });
    };
    updateCenterCard(1);

    /* ── Handle prev/next clicks with infinite loop ── */
    let isJumping = false;

    const scrollToSlideIndex = (globalIdx) => {
      const offset = getItemOffset();
      slider.scrollTo({ left: globalIdx * offset, behavior: 'smooth' });
    };

    /* Track which global index we're on */
    let currentGlobalIdx = realStartIdx + 1; /* starts centered on 2nd real slide visually (index realStartIdx+1 in the DOM) */

    /* Actually we want to track by scroll position */
    const getGlobalIndexFromScroll = () => {
      const offset = getItemOffset();
      if (offset === 0) return realStartIdx;
      return Math.round(slider.scrollLeft / offset);
    };

    /* Override native button behavior */
    const handlePrev = (e) => {
      e.preventDefault();
      e.stopImmediatePropagation();
      const curIdx = getGlobalIndexFromScroll();
      const targetIdx = curIdx - 1;
      centerRealIndex = ((centerRealIndex - 1) % totalOriginal + totalOriginal) % totalOriginal;
      updateCenterCard(centerRealIndex);
      scrollToSlideIndex(targetIdx);
    };
    const handleNext = (e) => {
      e.preventDefault();
      e.stopImmediatePropagation();
      const curIdx = getGlobalIndexFromScroll();
      const targetIdx = curIdx + 1;
      centerRealIndex = (centerRealIndex + 1) % totalOriginal;
      updateCenterCard(centerRealIndex);
      scrollToSlideIndex(targetIdx);
    };

    if (prevBtn) prevBtn.addEventListener('click', handlePrev, true);
    if (nextBtn) nextBtn.addEventListener('click', handleNext, true);

    /* ── Boundary detection: silently jump when entering clone territory ── */
    let scrollTimeout;
    slider.addEventListener('scroll', () => {
      if (isJumping) return;
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const offset = getItemOffset();
        if (offset === 0) return;
        const curIdx = getGlobalIndexFromScroll();

        /* If we scrolled into the SUFFIX clones (past all originals) */
        if (curIdx >= realStartIdx + totalOriginal) {
          isJumping = true;
          const mappedIdx = realStartIdx + (curIdx - realStartIdx - totalOriginal);
          jumpToIndex(mappedIdx);
          requestAnimationFrame(() => { isJumping = false; });
        }
        /* If we scrolled into the PREFIX clones */
        else if (curIdx < realStartIdx) {
          isJumping = true;
          const mappedIdx = realStartIdx + totalOriginal - (realStartIdx - curIdx);
          jumpToIndex(mappedIdx);
          requestAnimationFrame(() => { isJumping = false; });
        }

        /* Keep buttons enabled */
        if (prevBtn) prevBtn.removeAttribute('disabled');
        if (nextBtn) nextBtn.removeAttribute('disabled');
      }, 120);
    });

    /* ── Keep buttons always enabled even after SliderComponent.update() ── */
    const keepButtonsEnabled = () => {
      if (prevBtn) prevBtn.removeAttribute('disabled');
      if (nextBtn) nextBtn.removeAttribute('disabled');
    };
    const observer = new MutationObserver(keepButtonsEnabled);
    if (prevBtn) observer.observe(prevBtn, { attributes: true, attributeFilter: ['disabled'] });
    if (nextBtn) observer.observe(nextBtn, { attributes: true, attributeFilter: ['disabled'] });

    /* ── Re-center on resize ── */
    window.addEventListener('resize', () => {
      updateCenterCard(centerRealIndex);
      jumpToIndex(realStartIdx + centerRealIndex);
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 15,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.collection-list.settings.title.default",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_layout.content"
    },    
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.collection-list.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.collection-list.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label",
      "info": "t:sections.collection-list.settings.show_view_all.info"   
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.collection-list.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.collection-list.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.collection-list.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.collection-list.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
