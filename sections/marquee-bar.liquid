{%- style -%}
  #MarqueeBar-{{ section.id }} {
    --marquee-speed: {{ section.settings.marquee_speed }}s;
    --marquee-background: {{ section.settings.background_color }};
    --marquee-text: {{ section.settings.text_color }};
    --marquee-accent: {{ section.settings.accent_text_color }};
  }

  #MarqueeBar-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: var(--marquee-background);
    color: var(--marquee-text);
  }

  #MarqueeBar-{{ section.id }} .marquee-bar__image {
    display: block;
    width: 100%;
    height: {{ section.settings.image_height }}px;
    object-fit: cover;
  }

  #MarqueeBar-{{ section.id }} .marquee-bar__strip {
    display: flex;
    min-height: {{ section.settings.strip_height }}px;
    align-items: center;
    overflow: hidden;
  }

  #MarqueeBar-{{ section.id }} .marquee-bar__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: marquee-bar-scroll var(--marquee-speed) linear infinite;
    white-space: nowrap;
  }


  #MarqueeBar-{{ section.id }} .marquee-bar__item {
    display: inline-flex;
    align-items: center;
    gap: 3.5rem;
    padding-right: 3.5rem;
    font-family: 'Josefin Sans', sans-serif;
    font-size: clamp(2rem, 2.6vw, 3.8rem);
    font-weight: 300;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
  }

  #MarqueeBar-{{ section.id }} .marquee-bar__item strong {
    color: var(--marquee-accent);
    font-weight: 700;
  }

  #MarqueeBar-{{ section.id }} .marquee-bar__dot {
    font-size: 0.7em;
  }

  @keyframes marquee-bar-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media screen and (max-width: 749px) {
    #MarqueeBar-{{ section.id }} .marquee-bar__image {
      height: {{ section.settings.mobile_image_height }}px;
    }

    #MarqueeBar-{{ section.id }} .marquee-bar__item {
      gap: 2rem;
      padding-right: 2rem;
      font-size: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MarqueeBar-{{ section.id }} .marquee-bar__track {
      animation: none;
    }
  }
{%- endstyle -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;700&display=swap" rel="stylesheet">

<section id="MarqueeBar-{{ section.id }}" class="marquee-bar" aria-label="{{ section.settings.accessibility_label | escape }}">
  {%- if section.settings.background_image != blank -%}
    {{
      section.settings.background_image
      | image_url: width: 2400
      | image_tag:
        class: 'marquee-bar__image',
        loading: 'lazy',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        alt: ''
    }}
  {%- endif -%}

  <div class="marquee-bar__strip">
    <div class="marquee-bar__track" aria-hidden="true">
      {%- for repeat in (1..2) -%}
        <span class="marquee-bar__item">
          <span>{{ section.settings.primary_text | escape }}</span>
          <span class="marquee-bar__dot">•</span>
          <strong>{{ section.settings.accent_text | escape }}</strong>
          <span class="marquee-bar__dot">•</span>
        </span>
      {%- endfor -%}
    </div>
    <span class="visually-hidden">{{ section.settings.primary_text | escape }} {{ section.settings.accent_text | escape }}</span>
  </div>
</section>

{% schema %}
{
  "name": "Scrolling marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Promotional announcement"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Top background image"
    },
    {
      "type": "text",
      "id": "primary_text",
      "label": "Primary scrolling text",
      "default": "End of season sale"
    },
    {
      "type": "text",
      "id": "accent_text",
      "label": "Bold scrolling text",
      "default": "Black Friday"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Marquee speed",
      "default": 22
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 40,
      "max": 220,
      "step": 5,
      "unit": "px",
      "label": "Desktop image height",
      "default": 70
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Mobile image height",
      "default": 55
    },
    {
      "type": "range",
      "id": "strip_height",
      "min": 55,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Strip height",
      "default": 125
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Strip background color",
      "default": "#c8104f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Regular text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Bold text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Scrolling marquee"
    }
  ]
}
{% endschema %}
