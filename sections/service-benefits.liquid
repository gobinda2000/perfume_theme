{{ 'section-service-benefits.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="service-benefits color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <ul class="service-benefits__list" role="list">
      {%- for block in section.blocks -%}
        <li class="service-benefits__item" {{ block.shopify_attributes }}>
          <div class="service-benefits__icon">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 160
                | image_tag: widths: '80, 120, 160', sizes: '80px', alt: block.settings.title
              }}
            {%- else -%}
              {{ block.settings.icon | inline_asset_content }}
            {%- endif -%}
          </div>
          <div class="service-benefits__text">
            <h2 class="service-benefits__title">{{ block.settings.title | escape }}</h2>
            <p class="service-benefits__description">{{ block.settings.description | escape }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Service benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon",
          "info": "Optional. Upload a custom icon; otherwise the selected default icon is used."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Default icon",
          "options": [
            { "value": "icon-box.svg", "label": "Box" },
            { "value": "icon-lock.svg", "label": "Money guarantee" },
            { "value": "icon-chat-bubble.svg", "label": "Support" },
            { "value": "icon-discount.svg", "label": "Payment" }
          ],
          "default": "icon-box.svg"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Free shipping on over $49"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "icon-box.svg",
            "title": "Free Shipping",
            "description": "Free shipping on over $49"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "icon-lock.svg",
            "title": "Money Guarantee",
            "description": "Within 30 days for an exchange"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "icon-chat-bubble.svg",
            "title": "Online Support",
            "description": "24 hours a day, 7 days a week"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "icon-discount.svg",
            "title": "Flexible Payment",
            "description": "Pay with Multiple Credit Cards"
          }
        }
      ]
    }
  ]
}
{% endschema %}
